model Score {
  id              Int      @id @default(autoincrement())
  publicId        String   @unique @default(uuid()) @map("public_id") @db.Uuid
  sessionId       Int      @unique @map("session_id")
  contentScore    Float    @map("content_score")
  relevanceScore  Float    @map("relevance_score")
  confidenceScore Float    @map("confidence_score")
  overallScore    Float    @map("overall_score")
  scoredAt        DateTime @default(now()) @map("scored_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("scores")
}
