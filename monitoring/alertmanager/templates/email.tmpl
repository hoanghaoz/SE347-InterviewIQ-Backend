{{ define "interviewiq.email.html" }}
<!doctype html>
<html lang="en">
  <body style="margin:0;padding:0;background:#f3f4f6;color:#111827;font-family:Arial,Helvetica,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f4f6;padding:24px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="640" cellpadding="0" cellspacing="0" style="width:100%;max-width:640px;background:#ffffff;border:1px solid #d1d5db;border-radius:8px;overflow:hidden;">
            <tr>
              <td style="padding:20px 24px;border-top:4px solid {{ if eq .Status "firing" }}#dc2626{{ else }}#16a34a{{ end }};">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td>
                      <div style="font-family:Consolas,Monaco,monospace;font-size:12px;font-weight:700;letter-spacing:1px;color:#6b7280;">INTERVIEWIQ / MONITORING</div>
                      <h1 style="margin:8px 0 0;font-size:22px;line-height:1.3;color:#111827;">{{ .CommonLabels.alertname }}</h1>
                    </td>
                    <td align="right" valign="top">
                      <span style="display:inline-block;padding:6px 10px;border-radius:4px;background:{{ if eq .Status "firing" }}#fee2e2{{ else }}#dcfce7{{ end }};color:{{ if eq .Status "firing" }}#991b1b{{ else }}#166534{{ end }};font-family:Consolas,Monaco,monospace;font-size:12px;font-weight:700;">
                        {{ .Status | toUpper }}
                      </span>
                    </td>
                  </tr>
                </table>

                {{ with .CommonAnnotations.summary }}
                <p style="margin:16px 0 0;font-size:16px;line-height:1.5;color:#374151;">{{ . }}</p>
                {{ end }}
              </td>
            </tr>

            <tr>
              <td style="padding:0 24px 20px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;background:#f9fafb;border:1px solid #e5e7eb;">
                  <tr>
                    <td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;color:#6b7280;font-size:12px;width:120px;">Severity</td>
                    <td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;font-family:Consolas,Monaco,monospace;font-size:13px;font-weight:700;">{{ with .CommonLabels.severity }}{{ . | toUpper }}{{ else }}UNKNOWN{{ end }}</td>
                  </tr>
                  <tr>
                    <td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;color:#6b7280;font-size:12px;">Service</td>
                    <td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;font-family:Consolas,Monaco,monospace;font-size:13px;">{{ with .CommonLabels.service_name }}{{ . }}{{ else }}interviewiq{{ end }}</td>
                  </tr>
                  <tr>
                    <td style="padding:10px 12px;color:#6b7280;font-size:12px;">Alert count</td>
                    <td style="padding:10px 12px;font-family:Consolas,Monaco,monospace;font-size:13px;">{{ len .Alerts }}</td>
                  </tr>
                </table>
              </td>
            </tr>

            {{ range .Alerts }}
            <tr>
              <td style="padding:0 24px 20px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;border-left:3px solid {{ if eq .Status "firing" }}#dc2626{{ else }}#16a34a{{ end }};background:#ffffff;">
                  <tr>
                    <td style="padding:0 0 8px 14px;">
                      <div style="font-size:14px;font-weight:700;color:#111827;">{{ with .Annotations.summary }}{{ . }}{{ else }}{{ .Labels.alertname }}{{ end }}</div>
                      {{ with .Annotations.description }}
                      <div style="margin-top:6px;font-size:13px;line-height:1.5;color:#4b5563;">{{ . }}</div>
                      {{ end }}
                    </td>
                  </tr>
                  <tr>
                    <td style="padding:0 0 0 14px;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-family:Consolas,Monaco,monospace;font-size:11px;">
                        {{ range .Labels.SortedPairs }}
                        <tr>
                          <td style="padding:5px 8px;background:#f3f4f6;border-bottom:1px solid #ffffff;color:#6b7280;width:140px;">{{ .Name }}</td>
                          <td style="padding:5px 8px;background:#f9fafb;border-bottom:1px solid #ffffff;color:#111827;word-break:break-all;">{{ .Value }}</td>
                        </tr>
                        {{ end }}
                        <tr>
                          <td style="padding:5px 8px;background:#f3f4f6;color:#6b7280;">started_at</td>
                          <td style="padding:5px 8px;background:#f9fafb;color:#111827;">{{ .StartsAt.Format "2006-01-02 15:04:05 MST" }}</td>
                        </tr>
                      </table>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            {{ end }}

            <tr>
              <td style="padding:16px 24px;background:#111827;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td style="font-size:12px;color:#9ca3af;">Generated by Alertmanager</td>
                    <td align="right">
                      <a href="{{ .ExternalURL }}" style="color:#93c5fd;text-decoration:none;font-family:Consolas,Monaco,monospace;font-size:12px;">OPEN ALERTMANAGER →</a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
{{ end }}
