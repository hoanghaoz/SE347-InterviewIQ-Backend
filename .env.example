# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL=
JWT_SECRET=
DIRECT_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# App
PORT=3000

# Auth
JWT_SECRET=

# Mail cho app (OTP đăng ký). Gmail: MAIL_PASSWORD là App Password, không phải mật khẩu thường
# MAIL_SECURE=false với port 587 (STARTTLS), true với port 465
# Dev với Mailpit: MAIL_HOST=localhost (hoặc mailpit nếu app chạy trong Docker), MAIL_PORT=1025, MAIL_SECURE=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Mailpit (SMTP giả cho dev)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Redis (app chạy trong Docker dùng redis://redis:6379, compose.yml tự override)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible / Cloudflare R2)
S3_BUCKET_NAME=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
S3_API_ENDPOINT=

# OpenTelemetry
OTEL_SERVICE_NAME=interviewiq-api
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_NODE_RESOURCE_DETECTORS=env,host,os,serviceinstance,container
OTEL_LOG_LEVEL=info
OTEL_SDK_DISABLED=false

# grafana
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# prometheus
PROMETHEUS_PORT=9090

# SMTP
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERTMANAGER_PORT=9093
